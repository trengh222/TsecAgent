# ── LLM ───────────────────────────────────────────────
ANTHROPIC_BASE_URL=https://cn.luckyapi.chat
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=sk-2AmTAgPzfEy47O5AsbbuEBCrlSSTpI0Ew1JIconripJNsKbx

# 模型配置（run_agent.py 读取）
LLM_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=16384
LLM_STREAMING=true

# ── Python 执行器 ──────────────────────────────────────
PYTHON_DEFAULT_TIMEOUT=30
PYTHON_MAX_TIMEOUT=120

# ── Terminal 执行器 ────────────────────────────────────
TERMINAL_DEFAULT_DIR=/tmp

# ── Browser 执行器 ─────────────────────────────────────
BROWSER_HEADLESS=true
# CDP 模式：连接已有 Chrome，设置后 BROWSER_HEADLESS 无效
# BROWSER_CDP_URL=http://localhost:9222
# 浏览器流量经 Caido 代理拦截（与 PROXY_CAIDO_URL 同端口）
BROWSER_PROXY=http://127.0.0.1:8080
BROWSER_IGNORE_HTTPS=true
# BROWSER_USER_AGENT=

# ── Proxy 执行器（Caido）────────────────────────────────
# Caido HTTP 代理 + GraphQL API 地址（Settings → Listeners 查看端口）
PROXY_CAIDO_URL=http://127.0.0.1:8080
# Caido → Settings → API → Generate Token
PROXY_CAIDO_TOKEN=KwvVI4xjgk80f+k0Hyna+8lVcMzb3WKtzY+6F6FoRJ8gNTG4x2tAKCJguuILuZdYY910SivP0On3/DvN2ziW/g==.kmKXNJE0mAzbb1pdHNJ1evVCbNwVossq/p92Ool73+k=

# ── Knowledge 后端 ─────────────────────────────────────
# OpenViking 静态知识库（PayloadsAllTheThings / HowToHunt）
OPENVIKING_ENABLED=true
OPENVIKING_DATA_PATH=~/.openviking/data
# OpenViking 配置文件路径（不设置时自动查找 ~/.openviking/ov.conf）
# OPENVIKING_CONFIG_FILE=~/.openviking/ov.conf

# ChromaDB 动态知识库
CHROMA_PATH=./data/chroma
# 嵌入模型（默认 default = ChromaDB 内置 ONNX，无需 API Key）
# 可选：all-MiniLM-L6-v2（sentence-transformers）
#        text-embedding-3-small（OpenAI，需 OPENAI_API_KEY）
EMBEDDING_MODEL=default

# ── Recon 执行器 ────────────────────────────────────────
# FOFA 网络空间测绘（https://fofa.info → 个人中心 → API Key）
# FOFA_EMAIL=your@email.com
# FOFA_API_KEY=your_fofa_key

# Quake 360 网络空间测绘（https://quake.360.net → 个人中心 → API Token）
# QUAKE_TOKEN=your_quake_token
