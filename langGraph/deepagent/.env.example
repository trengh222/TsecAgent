# =============================================================================
# DeepAgent 环境配置
# =============================================================================

# ── LLM Provider ─────────────────────────────────────────────────────────────
# provider 选择：anthropic（默认，原生 Anthropic SDK）| openai（OpenAI 兼容端点）
LLM_PROVIDER=anthropic
# 通用 API Key / Base URL（切 provider 时填这两项；缺省回退下方 ANTHROPIC_*，向后兼容）
# LLM_API_KEY=
# LLM_BASE_URL=
#
# ── 各 provider 预设（取消注释启用；openai 均为 OpenAI 兼容端点）──
# [国际] Anthropic:    provider=anthropic, base=https://api.anthropic.com,                              model=claude-sonnet-4-6
# [国际] OpenAI:       provider=openai,    base=https://api.openai.com/v1,                              model=gpt-4o
# [国际] xAI Grok:     provider=openai,    base=https://api.x.ai/v1,                                       model=grok-2
# [国际] Gemini:       provider=openai,    base=https://generativelanguage.googleapis.com/v1beta/openai,  model=gemini-1.5-pro
# [国内] DeepSeek:     provider=openai,    base=https://api.deepseek.com/v1,                              model=deepseek-chat
# [国内] 通义千问:      provider=openai,    base=https://dashscope.aliyuncs.com/compatible-mode/v1,         model=qwen-plus
# [国内] 智谱GLM:      provider=openai,    base=https://open.bigmodel.cn/api/paas/v4,                     model=glm-4-plus
# [国内] 月之暗面Kimi:  provider=openai,    base=https://api.moonshot.cn/v1,                              model=moonshot-v1-32k
# [国内] 零一Yi:       provider=openai,    base=https://api.lingyiwanwu.com/v1,                            model=yi-large
# [国内] MiniMax:      provider=openai,    base=https://api.minimax.chat/v1,                              model=abab6.5s-chat
# [国内] 火山Doubao:   provider=openai,    base=https://ark.cn-beijing.volces.com/api/v3,                  model=doubao-pro-32k
# [国内] 百川Baichuan: provider=openai,    base=https://api.baichuan-ai.com/v1,                            model=Baichuan4
#
# 切换示例（DeepSeek）：取消注释填 key
#   LLM_PROVIDER=openai
#   LLM_API_KEY=sk-你的deepseek密钥
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat

# ── Anthropic API（LLM_PROVIDER=anthropic 时使用，或作为 LLM_API_KEY/LLM_BASE_URL 回退）──
# 必填：Anthropic API Key（或兼容代理的 API Key）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 备用：AUTH_TOKEN（当 API_KEY 为空时使用）
# ANTHROPIC_AUTH_TOKEN=
# API 代理地址（使用中转代理时修改此项）
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── LLM 模型配置 ──────────────────────────────────────────────────────────────
LLM_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=25000
LLM_STREAMING=true
# 提示词最大字符数（超出自动截断），默认 80000
# LLM_MAX_PROMPT_CHARS=80000

# ── Python 执行器 ─────────────────────────────────────────────────────────────
PYTHON_DEFAULT_TIMEOUT=30
PYTHON_MAX_TIMEOUT=120

# ── Terminal 执行器 ───────────────────────────────────────────────────────────
# Windows 默认自动使用 %TEMP%\tsecagent-sandbox（自动创建），建议设为专用目录
# POSIX 默认 /home/daytona
# Windows 示例: TERMINAL_DEFAULT_DIR=D:\pts-sandbox
TERMINAL_DEFAULT_DIR=/home/daytona

# ── Browser 执行器 (Playwright) ───────────────────────────────────────────────
BROWSER_HEADLESS=true
# CDP 连接已有浏览器（设置后忽略 HEADLESS 模式）
# BROWSER_CDP_URL=http://localhost:9222
# 浏览器代理（与 BurpSuite / Caido 联动）
# BROWSER_PROXY=http://127.0.0.1:8080
BROWSER_IGNORE_HTTPS=true
# BROWSER_USER_AGENT=

# ── Proxy 执行器 (Caido) ──────────────────────────────────────────────────────
PROXY_CAIDO_URL=http://127.0.0.1:8080
# Caido API 令牌（Caido → Settings → API → Generate Token）
# PROXY_CAIDO_TOKEN=

# ── 侦察 (Recon) ──────────────────────────────────────────────────────────────
# FOFA 测绘平台
# FOFA_EMAIL=
# FOFA_API_KEY=
# Quake 测绘平台
# QUAKE_TOKEN=

# ── 知识库 ────────────────────────────────────────────────────────────────────
# OpenViking 静态知识库（可选）
OPENVIKING_ENABLED=false
# OPENVIKING_DATA_PATH=~/.openviking/data
# OPENVIKING_CONFIG_FILE=
# ChromaDB 持久化路径
CHROMA_PATH=./data/chroma
# 嵌入模型（default=ChromaDB 内置 ONNX，无需 API Key）
# 可选：text-embedding-3-small（OpenAI）/ all-MiniLM-L6-v2（sentence-transformers）
EMBEDDING_MODEL=default
